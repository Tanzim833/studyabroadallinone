{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/editorial/**",
              "components/forms/**",
              "components/navigation/**",
              "components/pricing/**",
              "components/surfaces/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter Display|Noto Sans Bengali))/i]",
        "message": "Font not provided by the design system. Available: Inter Display, Noto Sans Bengali."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|tone|thumbLabel|category|title|meta|href|onClick|key|ref|className|style|children)$/]",
        "message": "<ArticleCard> doesn't accept that prop. Declared props: image, tone, thumbLabel, category, title, meta, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:peach|mint|yellow|mustard|cream|coral|forest)$/]",
        "message": "<ArticleCard> tone must be one of 'peach' | 'mint' | 'yellow' | 'mustard' | 'cream' | 'coral' | 'forest'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|style|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|info|success|count|on-dark)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'info' | 'success' | 'count' | 'on-dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|active|fullWidth|icon|href|type|onClick|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, active, fullWidth, icon, href, type, onClick, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|secondary-on-dark|legal)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'secondary-on-dark' | 'legal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CreamCallout'] > JSXAttribute > JSXIdentifier[name!=/^(?:stat|title|body|children|style|key|ref|className|style|children)$/]",
        "message": "<CreamCallout> doesn't accept that prop. Declared props: stat, title, body, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaBandLight'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|ctaLabel|onCta|secondary|key|ref|className|style|children)$/]",
        "message": "<CtaBandLight> doesn't accept that prop. Declared props: title, body, ctaLabel, onCta, secondary."
      },
      {
        "selector": "JSXOpeningElement[name.name='DemoGridCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|caption|children|minHeight|style|key|ref|className|style|children)$/]",
        "message": "<DemoGridCard> doesn't accept that prop. Declared props: tone, title, caption, children, minHeight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DemoGridCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:peach|mint|yellow|mustard|forest|cream|canvas)$/]",
        "message": "<DemoGridCard> tone must be one of 'peach' | 'mint' | 'yellow' | 'mustard' | 'forest' | 'cream' | 'canvas'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|title|body|steps|preview|linkLabel|key|ref|className|style|children)$/]",
        "message": "<FeatureTab> doesn't accept that prop. Declared props: label, title, body, steps, preview, linkLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|links|lines|key|ref|className|style|children)$/]",
        "message": "<FooterColumn> doesn't accept that prop. Declared props: title, links, lines."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|subtitle|primaryLabel|secondaryLabel|onPrimary|onSecondary|children|key|ref|className|style|children)$/]",
        "message": "<HeroBand> doesn't accept that prop. Declared props: eyebrow, title, subtitle, primaryLabel, secondaryLabel, onPrimary, onSecondary, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|onClick|active|disabled|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: children, label, onClick, active, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|items|key|ref|className|style|children)$/]",
        "message": "<LogoStrip> doesn't accept that prop. Declared props: label, items."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingComparisonRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|values|heading|labelWidth|key|ref|className|style|children)$/]",
        "message": "<PricingComparisonRow> doesn't accept that prop. Declared props: label, values, heading, labelWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComparisonSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|rows|key|ref|className|style|children)$/]",
        "message": "<ComparisonSection> doesn't accept that prop. Declared props: title, rows."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingPillButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|fullWidth|active|onClick|style|children|key|ref|className|style|children)$/]",
        "message": "<PricingPillButton> doesn't accept that prop. Declared props: variant, fullWidth, active, onClick, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingPillButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|solid)$/]",
        "message": "<PricingPillButton> variant must be one of 'outline' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingTierCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|unit|description|features|ctaLabel|ctaVariant|onCta|featured|key|ref|className|style|children)$/]",
        "message": "<PricingTierCard> doesn't accept that prop. Declared props: name, price, unit, description, features, ctaLabel, ctaVariant, onCta, featured."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingTierCard'] > JSXAttribute[name.name='ctaVariant'] > Literal[value!=/^(?:outline|solid)$/]",
        "message": "<PricingTierCard> ctaVariant must be one of 'outline' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignatureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|eyebrow|title|body|ctaLabel|onCta|children|minHeight|key|ref|className|style|children)$/]",
        "message": "<SignatureCard> doesn't accept that prop. Declared props: tone, eyebrow, title, body, ctaLabel, onCta, children, minHeight."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignatureCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:coral|forest|dark)$/]",
        "message": "<SignatureCard> tone must be one of 'coral' | 'forest' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|status|placeholder|value|defaultValue|onChange|type|prefix|suffix|disabled|forceFocus|id|style|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: label, hint, status, placeholder, value, defaultValue, onChange, type, prefix, suffix, disabled, forceFocus, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:success)$/]",
        "message": "<TextInput> status must be one of 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|onClick|tone|arrow|style|children|key|ref|className|style|children)$/]",
        "message": "<TextLink> doesn't accept that prop. Declared props: href, onClick, tone, arrow, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:link|ink|on-dark)$/]",
        "message": "<TextLink> tone must be one of 'link' | 'ink' | 'on-dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopicItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|count|key|ref|className|style|children)$/]",
        "message": "<TopicItem> doesn't accept that prop. Declared props: label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|links|active|onNavigate|onBrand|onAssessment|onConsultation|onLogin|sticky|key|ref|className|style|children)$/]",
        "message": "<TopNav> doesn't accept that prop. Declared props: brand, links, active, onNavigate, onBrand, onAssessment, onConsultation, onLogin, sticky."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
